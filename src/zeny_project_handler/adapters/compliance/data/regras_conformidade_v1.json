          "fact": "vao.aplicabilidade_excecao_45_60_resolvida",
          "operator": "IGUAL",
          "expected": [true]
        }
      ],
      "unless": [
        {
          "fact": "vao.excecao_45_60_demonstrada",
          "operator": "EXISTE",
          "expected": []
        }
      ],
      "must": [
        {
          "fact": "vao.comprimento_m",
          "operator": "MENOR_OU_IGUAL",
          "expected": [45]
        }
      ],
      "enabled": true
