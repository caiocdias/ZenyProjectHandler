classDiagram
direction LR

namespace DominioProjeto {
    class Projeto {
        +UUID id
        +String nome
        +DocumentoProjeto[] documentos
        +ElementoProjeto[] elementos
        +PontoRede[] pontos
    }
    class DocumentoProjeto {
        +UUID id
        +String nomeArquivo
        +String sha256
        +PaginaDocumento[] paginas
    }
    class PaginaDocumento {
        +UUID id
        +Integer numero
        +Dimensoes dimensoes
        +Integer rotacao
    }
    class ElementoProjeto {
        +UUID id
        +SituacaoProjeto situacao
        +GeometriaDocumento geometria
    }
    class Poste
    class EstruturaMt
    class EstruturaBt
    class Cabo
    class Equipamento
    class PontoRede
    class VaoDetectado
}

namespace Catalogo {
    class CatalogoTecnico {
        +UUID id
        +String versao
        +ItemCatalogo[] itens
    }
    class ItemCatalogo {
        +UUID id
        +String codigo
        +CategoriaElemento categoria
    }
    class CompatibilidadeEstruturaCabo
}

namespace Analise {
    class ExecucaoAnalise {
        +UUID id
        +EstadoExecucaoAnalise estado
        +String metodo
        +String versao
    }
    class EvidenciaDocumento {
        +UUID id
        +TipoEvidencia tipo
        +GeometriaDocumento geometria
        +OrigemObjetoPdf origem
    }
    class PropostaElemento {
        +UUID id
        +CategoriaElemento categoria
        +Decimal confianca
    }
    class PropostaRelacao
    class DecisaoRevisao
    class RegiaoAnalise
}

namespace Conformidade {
    class RegistroRegrasConformidade {
        +String versao
        +RegraConformidade[] regras
    }
    class RegraConformidade {
        +String id
        +CondicaoConformidade[] aplicabilidade
        +CondicaoConformidade[] excecoes
        +CondicaoConformidade[] requisitos
    }
    class FatoConformidade
    class ExecucaoConformidade
    class AchadoConformidade
    class CalloutConformidade
}

namespace Aplicacao {
    class ServicoFluxoMvp
    class ServicoRevisaoHumana
    class ExecutarPipelineInterpretacao
    class ExecutarAnaliseConformidade
    class ServicoPortabilidadeProjeto
    class CoordenadorOperacoes
}

namespace Infraestrutura {
    class PyMuPdfReader
    class PyMuPdfDocumentAnalyzer
    class TesseractCliOcr
    class SqlAlchemyUnitOfWork
    class ZipProjectArchive
}

Projeto "1" *-- "0..*" DocumentoProjeto
DocumentoProjeto "1" *-- "1..*" PaginaDocumento
Projeto "1" *-- "0..*" ElementoProjeto
Projeto "1" *-- "0..*" PontoRede
ElementoProjeto <|-- Poste
ElementoProjeto <|-- EstruturaMt
ElementoProjeto <|-- EstruturaBt
ElementoProjeto <|-- Cabo
ElementoProjeto <|-- Equipamento
Projeto --> CatalogoTecnico : usa versão
ElementoProjeto --> ItemCatalogo : tipado por
CatalogoTecnico *-- ItemCatalogo
CatalogoTecnico *-- CompatibilidadeEstruturaCabo

ExecucaoAnalise *-- EvidenciaDocumento
ExecucaoAnalise *-- PropostaElemento
ExecucaoAnalise *-- PropostaRelacao
PropostaElemento --> EvidenciaDocumento : fundamentada por
PropostaRelacao --> EvidenciaDocumento : fundamentada por
DecisaoRevisao --> PropostaElemento : confirma ou corrige
RegiaoAnalise --> PropostaElemento : agrupa
VaoDetectado --> Cabo : deriva de

RegistroRegrasConformidade *-- RegraConformidade
ExecutarAnaliseConformidade --> FatoConformidade : reúne
ExecutarAnaliseConformidade --> RegistroRegrasConformidade : aplica
ExecutarAnaliseConformidade --> ExecucaoConformidade : persiste
ExecucaoConformidade *-- AchadoConformidade
AchadoConformidade --> CalloutConformidade : projeta no PDF

ServicoFluxoMvp --> PyMuPdfReader
ServicoFluxoMvp --> PyMuPdfDocumentAnalyzer
ServicoFluxoMvp --> ExecutarPipelineInterpretacao
ServicoFluxoMvp --> ExecutarAnaliseConformidade
ServicoRevisaoHumana --> SqlAlchemyUnitOfWork
ServicoPortabilidadeProjeto --> ZipProjectArchive
ServicoPortabilidadeProjeto --> SqlAlchemyUnitOfWork
PyMuPdfDocumentAnalyzer --> TesseractCliOcr : fallback condicional
ServicoFluxoMvp --> CoordenadorOperacoes
ServicoPortabilidadeProjeto --> CoordenadorOperacoes
