    {
      "id": "nd31.equipamento.estrutura-angulo",
      "title": "Equipamento em estrutura de ângulo",
      "description": "Exceto chave fusível, equipamentos não devem ser instalados em estruturas de ângulo ou postes de esquina; para deflexão de até 30 graus a norma exige avaliação do risco de abalroamento.",
      "scope": "REGIAO",
      "severity": "CRITICA",
      "source": {
        "document": "CEMIG ND-3.1",
        "revision": "Jul/2025",
        "item": "Dimensionamento Mecânico, observação j",
        "page": 66,
        "url": "https://www.cemig.com.br/wp-content/uploads/2025/10/ND_3_1_2025.pdf"
      },
      "when": [
