      "scope": "REGIAO",
      "severity": "ERRO",
      "source": {
        "document": "CEMIG ND-3.1",
        "revision": "Jul/2025",
        "item": "Locação de Postes, 3, alíneas b e c",
        "page": 27,
        "url": "https://www.cemig.com.br/wp-content/uploads/2025/10/ND_3_1_2025.pdf"
      },
      "when": [
        {
          "fact": "rede.contexto_urbano",
          "operator": "IGUAL",
          "expected": [true]
        },
        {
          "fact": "cabo.tecnologia",
          "operator": "EM",
          "expected": ["PROTEGIDA", "ISOLADA"],
          "quantifier": "QUALQUER"
