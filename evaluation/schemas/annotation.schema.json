{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zeny.local/schemas/evaluation/annotation-v1.json",
  "title": "Anotação de amostra",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "annotation_id", "dataset_id", "dataset_version", "sample_id",
    "document_sha256", "role", "status", "annotator_id", "created_at", "reviewed_at",
    "reviewer_id", "elements", "relations"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "annotation_id": {"$ref": "#/$defs/identifier"},
    "dataset_id": {"$ref": "#/$defs/identifier"},
    "dataset_version": {"type": "string", "minLength": 1},
    "sample_id": {"$ref": "#/$defs/identifier"},
    "document_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "role": {"enum": ["PRIMARIA", "SECUNDARIA", "CONSENSO"]},
    "status": {"enum": ["RASCUNHO", "REVISADA", "CONGELADA"]},
    "annotator_id": {"$ref": "#/$defs/identifier"},
    "created_at": {"type": "string", "format": "date-time"},
    "reviewed_at": {"type": ["string", "null"], "format": "date-time"},
    "reviewer_id": {"oneOf": [{"$ref": "#/$defs/identifier"}, {"type": "null"}]},
    "elements": {"type": "array", "items": {"$ref": "#/$defs/element"}},
    "relations": {"type": "array", "items": {"$ref": "#/$defs/relation"}}
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "coordinate": {"type": ["string", "number"], "pattern": "^(0(?:\\.\\d+)?|1(?:\\.0+)?)$"},
    "point": {
      "type": "array", "prefixItems": [{"$ref": "#/$defs/coordinate"}, {"$ref": "#/$defs/coordinate"}],
      "minItems": 2, "maxItems": 2
    },
    "geometry": {
      "type": "object", "additionalProperties": false, "required": ["type", "points"],
      "properties": {
        "type": {"enum": ["PONTO", "CAIXA", "POLILINHA", "POLIGONO"]},
        "points": {"type": "array", "items": {"$ref": "#/$defs/point"}, "minItems": 1}
      }
    },
    "element": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "category", "situation", "catalog_code", "page", "geometry"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "category": {"enum": ["POSTE", "ESTRUTURA_MT", "ESTRUTURA_BT", "CABO", "EQUIPAMENTO"]},
        "situation": {"enum": ["EXISTENTE", "INSTALAR", "REMOVER"]},
        "catalog_code": {"type": ["string", "null"]},
        "page": {"type": "integer", "minimum": 1},
        "geometry": {"$ref": "#/$defs/geometry"}
      }
    },
    "relation": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "source_id", "target_id", "type", "directed"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "source_id": {"$ref": "#/$defs/identifier"},
        "target_id": {"$ref": "#/$defs/identifier"},
        "type": {"type": "string", "minLength": 1},
        "directed": {"type": "boolean"}
      }
    }
  }
}
