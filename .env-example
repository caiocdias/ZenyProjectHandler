# Copie este arquivo para .env e substitua a senha antes de iniciar o servidor.
# Use uma senha longa e aleatoria. Nao versionar o .env real.
ZENY_SERVER_PASSWORD=troque-por-uma-senha-longa-e-aleatoria
ZENY_SERVER_HOST=0.0.0.0
ZENY_SERVER_PORT=8000
ZENY_SERVER_DATA_DIR=/data
ZENY_CLIENT_SERVER_URL=http://127.0.0.1:8000
