{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zeny.local/schemas/evaluation/manifest-v1.json",
  "title": "Manifesto anônimo do conjunto de avaliação",
  "type": "object",
  "required": [
    "schema_version", "dataset_id", "dataset_version", "status", "created_at", "frozen_at",
    "access_policy", "sensitive_source_files", "pdf_count", "samples"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "dataset_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "dataset_version": {"type": "string", "minLength": 1},
    "status": {"enum": ["EM_PREPARACAO", "CONGELADO"]},
    "created_at": {"type": "string", "format": "date-time"},
    "frozen_at": {"type": ["string", "null"], "format": "date-time"},
    "access_policy": {"type": "string", "minLength": 1},
    "sensitive_source_files": {"const": true},
    "pdf_count": {"type": "integer", "minimum": 1},
    "samples": {
      "type": "array", "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "id", "sha256", "bytes", "pages", "split", "scale", "format", "orientation",
          "quality", "density", "double_annotation"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "bytes": {"type": "integer", "minimum": 1},
          "pages": {"type": "integer", "minimum": 1},
          "split": {"enum": ["DESENVOLVIMENTO", "TESTE"]},
          "scale": {"type": "string", "minLength": 1},
          "format": {"type": "string", "minLength": 1},
          "orientation": {"type": "string", "minLength": 1},
          "quality": {"type": "string", "minLength": 1},
          "density": {"type": "string", "minLength": 1},
          "double_annotation": {"type": "boolean"},
          "expected_spans": {
            "type": "object",
            "propertyNames": {"enum": ["EXISTENTE", "INSTALAR", "REMOVER"]},
            "additionalProperties": {
              "type": "array",
              "items": {"type": "number", "exclusiveMinimum": 0}
            }
          },
          "known_edge_cases": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
        }
      }
    }
  }
}
