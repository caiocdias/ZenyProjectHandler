# Copie para .env, gere uma senha longa e mantenha o arquivo somente no host servidor.
ZENY_SERVER_PASSWORD=troque-por-uma-senha-longa-e-aleatoria
ZENY_SERVER_IMAGE=@ZENY_SERVER_IMAGE@

# O padrão aceita somente o host. Para clientes na LAN, use o IPv4 privado específico do servidor.
ZENY_SERVER_BIND_ADDRESS=127.0.0.1
ZENY_SERVER_PORT=8000
ZENY_SERVER_LOG_LEVEL=INFO
ZENY_SERVER_UPLOAD_MAX_BYTES=268435456
ZENY_SERVER_RENDER_DPI=600
ZENY_SERVER_RENDER_MAX_PIXELS=8000000
ZENY_SERVER_RENDER_MAX_BYTES=67108864
ZENY_SERVER_VIEWER_SESSION_TTL_SECONDS=900
ZENY_SERVER_VIEWER_MAX_FILES=20
ZENY_SERVER_JOB_RETENTION_SECONDS=86400
ZENY_SERVER_JOB_MAX_RETAINED=100
ZENY_SERVER_TRANSFER_TTL_SECONDS=3600
ZENY_SERVER_TMPFS_SIZE=268435456
ZENY_SERVER_PIDS_LIMIT=256
ZENY_SERVER_MEMORY_LIMIT=2g
